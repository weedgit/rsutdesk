* text=auto

# Linux packaging: scripts and unit files must keep Unix line endings in every checkout,
# including Windows ones, or the .deb's install scripts fail with "No such file or directory".
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.spec text eol=lf
res/DEBIAN/* text eol=lf
res/PKGBUILD text eol=lf
res/pacman_install text eol=lf
